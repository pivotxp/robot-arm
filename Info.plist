<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The rail's Siemens PLC web server uses an old self-signed certificate. Without this key
	     iOS refuses to talk to https://192.168.1.2 at all. It only relaxes the rule for local
	     (192.168.x.x) addresses, never for the public internet. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- ATS off for the whole rig. It is a closed local network with no internet: the rail's
		     PLC is https with an old self-signed cert, and the Canon on USB-C serves CCAPI as plain
		     http at 192.0.0.1:8080. NSAllowsLocalNetworking is deliberately NOT set here — when it
		     is present iOS ignores NSAllowsArbitraryLoads, and 192.0.0.1 is not a range ATS counts
		     as "local", so the camera load was blocked with error -1022. Arbitrary loads alone lets
		     both through; the explicit 192.0.0.1 exception is belt-and-suspenders. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Show the app's Documents folder (the program files) in the Files app, so a program can
	     also be edited as plain text if you ever want to. -->
	<key>NSCameraUsageDescription</key>
	<string>The booth screen records the guest on this iPad's camera while the rig runs.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Finished clips are saved to Photos.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
