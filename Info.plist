<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The rail's Siemens PLC web server uses an old self-signed certificate. Without this key
	     iOS refuses to talk to https://192.168.1.2 at all. It only relaxes the rule for local
	     (192.168.x.x) addresses, never for the public internet. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The Canon on USB-C serves CCAPI as plain http at 192.0.0.1:8080. That address is not
		     one of the private ranges NSAllowsLocalNetworking covers, so without arbitrary loads
		     iOS blocks it with error -1022. This matches the working AuraBooth build. The rig is a
		     closed local network with no internet, so this opens nothing to the outside. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Show the app's Documents folder (the program files) in the Files app, so a program can
	     also be edited as plain text if you ever want to. -->
	<key>NSCameraUsageDescription</key>
	<string>The booth screen records the guest on this iPad's camera while the rig runs.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Finished clips are saved to Photos.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
